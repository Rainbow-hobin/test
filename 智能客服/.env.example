# ===== LLM 配置（必填，才能真正跑通"生成回答"） =====
# 获取方式：https://platform.deepseek.com 注册并充值（几块钱够跑很久）→ API Keys 里创建
# 把 key 填到同目录 .env 文件的 DEEPSEEK_API_KEY= 后面（本文件是模板，不要改）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 下面两个一般不用改（默认就是 DeepSeek；换通义/智谱/OpenAI 时改这里）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 检索配置（可选，默认值即可用） =====
# 向量库持久化目录（相对项目根目录）
CHROMA_DIR=.chroma
# 每次回答检索多少条知识
TOP_K=3
